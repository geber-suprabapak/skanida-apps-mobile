{
  "cli": {
    "version": ">= 15.0.15",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": { "EAS_LOCAL_BUILD_ARTIFACTS_DIR": "/mnt/banter/artifact" }
    },
    "production": {
      "autoIncrement": false,
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=arm64-v8a --daemon --parallel --configure-on-demand --build-cache"
      },
      "env": {
        "EAS_LOCAL_BUILD_ARTIFACTS_DIR": "/home/evernight/artifacts"
      }
    },
    "production-armv7a": {
      "autoIncrement": false,
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=armeabi-v7a --daemon --parallel --configure-on-demand --build-cache"
      },
      "env": {
        "EAS_LOCAL_BUILD_ARTIFACTS_DIR": "/home/evernight/artifacts"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
