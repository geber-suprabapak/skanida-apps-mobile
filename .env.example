# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Face API Configuration
EXPO_PUBLIC_FACE_API_URL=https://your-face-api-url
EXPO_PUBLIC_AUTH_CALLBACK_URL=skanida-apps-mobile://auth/reset-callback

# Sentry Error Monitoring
# Get your DSN from: https://sentry.io → Project Settings → Client Keys (DSN)
EXPO_PUBLIC_SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/your-project-id
