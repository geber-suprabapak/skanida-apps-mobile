# Astra / Logto identity
EXPO_PUBLIC_LOGTO_ENDPOINT=http://localhost:3001
EXPO_PUBLIC_LOGTO_APP_ID=skanida-mobile

# BFF Configuration
EXPO_PUBLIC_BFF_API_URL=https://your-bff-url
EXPO_PUBLIC_LOGTO_REDIRECT_URI=skanida://auth/callback

# Sentry Error Monitoring
# Get your DSN from: https://sentry.io → Project Settings → Client Keys (DSN)
EXPO_PUBLIC_SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/your-project-id
