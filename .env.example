# Environment Configuration for Appwrite Migration

# Copy this to your .env file and update with your Appwrite project details

# ================================
# APPWRITE CONFIGURATION
# ================================

# Appwrite Server Endpoint (Cloud or Self-hosted)
EXPO_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
# For self-hosted: EXPO_PUBLIC_APPWRITE_ENDPOINT=https://your-appwrite-domain.com/v1

# Appwrite Project ID (Create project in Appwrite Console)
EXPO_PUBLIC_APPWRITE_PROJECT_ID=your_project_id_here

# Appwrite Database ID (Create database in your project)
EXPO_PUBLIC_APPWRITE_DATABASE_ID=your_database_id_here

# ================================
# APPWRITE COLLECTIONS
# ================================

# User Profiles Collection ID
EXPO_PUBLIC_APPWRITE_USER_PROFILES_COLLECTION_ID=user_profiles

# Absences Collection ID  
EXPO_PUBLIC_APPWRITE_ABSENCES_COLLECTION_ID=absences

# Perizinan (Leave Requests) Collection ID
EXPO_PUBLIC_APPWRITE_PERIZINAN_COLLECTION_ID=perizinan

# ================================
# APPWRITE STORAGE BUCKETS
# ================================

# Attendance Photos Storage Bucket ID
EXPO_PUBLIC_APPWRITE_ATTENDANCE_PHOTOS_STORAGE=attendance-photos

# Perizinan Documents Storage Bucket ID
EXPO_PUBLIC_APPWRITE_PERIZINAN_STORAGE=perizinan

# Avatars Storage Bucket ID
EXPO_PUBLIC_APPWRITE_AVATARS_STORAGE=avatars

# ================================
# EXISTING SUPABASE CONFIGURATION
# ================================
# Keep these during migration for comparison/fallback

# Supabase URL
EXPO_PUBLIC_SUPABASE_URL=your_supabase_url_here

# Supabase Anonymous Key
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ================================
# MIGRATION CONFIGURATION
# ================================

# Enable migration mode (true/false)
EXPO_PUBLIC_MIGRATION_MODE=true

# Backend to use during migration (supabase/appwrite/dual)
EXPO_PUBLIC_ACTIVE_BACKEND=supabase

# Enable migration logging (true/false)
EXPO_PUBLIC_MIGRATION_LOGGING=true